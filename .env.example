# =================================
# USER APP ENVIRONMENT VARIABLES
# =================================

# Database Connection
DATABASE_URL="postgresql://user:password@localhost:5432/payments"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-generate-with-openssl-rand-base64-32"

# JWT Configuration  
JWT_SECRET="your-jwt-secret-key-generate-with-openssl-rand-base64-32"

# Session Configuration (optional)
SESSION_MAX_AGE=2592000  # 30 days in seconds

# Node Environment
NODE_ENV="development"  # Change to "production" for prod

# =================================
# BANK WEBHOOK ENVIRONMENT VARIABLES  
# =================================

# Server Configuration
PORT=3002
NODE_ENV="development"  # Change to "production" for prod

# Database Connection (same as user app or separate)
DATABASE_URL="postgresql://user:password@localhost:5432/payments"

# Webhook Security
WEBHOOK_SECRET="your-webhook-secret-shared-with-bank-partners"
ALLOWED_WEBHOOK_IPS="1.2.3.4,5.6.7.8"  # Comma-separated bank server IPs
ALLOWED_ORIGINS="https://your-frontend-domain.com"

# Optional: Monitoring
SENTRY_DSN="your-sentry-dsn-for-error-tracking"

# =================================
# GENERATE SECURE SECRETS
# =================================
# Run these commands to generate secure random secrets:
#
# NEXTAUTH_SECRET:
#   openssl rand -base64 32
#
# JWT_SECRET:
#   openssl rand -base64 32
#
# WEBHOOK_SECRET:
#   openssl rand -base64 48
#
# =================================
