// MICROSERVICES-READY PRISMA SCHEMA
// Loosely coupled design - can split into microservices later if needed
// User and Wallet have NO FK constraint - ready for service separation

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// USER MODEL - Can be moved to separate User Service
model User {
  id       String  @id @default(uuid())
  email    String  @unique
  phone    String? @unique
  password String?
  name     String?

  // REMOVED: Hard FK constraint to Wallet
  // For microservices: Query Wallet Service via API using userId

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@index([phone])
  @@map("users")
}

// WALLET MODEL - Can be moved to separate Wallet Service
model Wallet {
  id      String  @id @default(uuid())
  userId  String  @unique // Loose reference to User (NO FK for microservices)
  balance Decimal @default(0.0) @db.Decimal(10, 2)

  // These relations stay within Wallet Service
  sentTransactions     Transaction[] @relation("SentTransactions")
  receivedTransactions Transaction[] @relation("ReceivedTransactions")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@map("wallets")
}

// TRANSACTION MODEL - Stays with Wallet Service
model Transaction {
  id          String @id @default(uuid())
  referenceId String @unique

  senderId   String?
  receiverId String?

  // FK constraints are OK within same service
  sender   Wallet? @relation("SentTransactions", fields: [senderId], references: [id], onDelete: SetNull)
  receiver Wallet? @relation("ReceivedTransactions", fields: [receiverId], references: [id], onDelete: SetNull)

  amount Decimal @db.Decimal(10, 2)

  type   TransactionType
  status TransactionStatus

  description String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("transactions")
}

enum TransactionStatus {
  Pending
  Completed
  Failed
  Refunded
}

enum TransactionType {
  P2P_Transfer
  credit
  debit
  refund
}
